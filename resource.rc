#include <windows.h>
#include "resource.h"

IDR_VERSION VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "FileDescription", "Any_Shortcut_for_AviUtl2 - AviUtl2 ショートカット機能拡張プラグイン"
            VALUE "FileVersion", "1.00"
            VALUE "InternalName", "Any_Shortcut_for_AviUtl2"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "ProductName", "Any_Shortcut_for_AviUtl2"
            VALUE "ProductVersion", "1.00"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END

IDD_MAIN_DIALOG DIALOGEX 0, 0, 560, 400
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Any_Shortcut_for_AviUtl2 設定 - コマンド管理"
FONT 9, "MS UI Gothic", 0, 0, 0x0
BEGIN
    CONTROL "", IDC_CMD_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL, 10, 10, 440, 290
    PUSHBUTTON "追加(&A)", IDC_BTN_ADD, 460, 10, 90, 24
    PUSHBUTTON "編集(&E)", IDC_BTN_EDIT, 460, 40, 90, 24
    PUSHBUTTON "削除(&D)", IDC_BTN_DELETE, 460, 70, 90, 24
    LTEXT "キー割り当ては AviUtl2 標準の「ショートカットキーの設定」画面で行ってください。", -1, 10, 310, 440, 14
    PUSHBUTTON "保存(&S)", IDC_BTN_SAVE, 460, 320, 90, 24
    PUSHBUTTON "閉じる(&C)", IDC_BTN_CLOSE, 460, 370, 90, 24
END

IDD_CMDEDIT_DIALOG DIALOGEX 0, 0, 480, 430
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "コマンド編集"
FONT 9, "MS UI Gothic", 0, 0, 0x0
BEGIN
    LTEXT "名前:", IDC_STATIC_CMDNAME, 10, 10, 50, 14
    EDITTEXT IDC_EDIT_NAME, 60, 8, 180, 14, ES_AUTOHSCROLL
    LTEXT "カテゴリ:", IDC_STATIC_CATEGORY, 250, 10, 55, 14
    EDITTEXT IDC_EDIT_CATEGORY, 310, 8, 160, 14, ES_AUTOHSCROLL

    GROUPBOX "登録済みステップ", -1, 10, 50, 460, 145
    CONTROL "", IDC_STEP_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 20, 65, 350, 115
    PUSHBUTTON "▲ 上へ",  IDC_BTN_UP,   385, 65, 75, 24
    PUSHBUTTON "▼ 下へ",  IDC_BTN_DOWN, 385, 93, 75, 24
    PUSHBUTTON "削除",     IDC_BTN_DEL_STEP, 385, 125, 75, 24

    GROUPBOX "ステップを追加", -1, 10, 200, 460, 155
    LTEXT "種別:", -1, 20, 218, 35, 14
    COMBOBOX IDC_COMBO_STEPTYPE, 55, 216, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "対象:", -1, 200, 218, 35, 14
    COMBOBOX IDC_EDIT_TARGET, 240, 216, 155, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "参照", IDC_BTN_BROWSE, 400, 216, 35, 14
    LTEXT "パラメータ名:", IDC_STATIC_PARAMLABEL, 20, 245, 65, 14
    COMBOBOX IDC_EDIT_PARAMNAME, 90, 243, 150, 160, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "値:", IDC_STATIC_VALUELABEL, 250, 245, 25, 14
    EDITTEXT IDC_EDIT_PARAMVALUE, 280, 243, 115, 14, ES_AUTOHSCROLL
    COMBOBOX IDC_COMBO_VALMODE, 355, 260, 35, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "加減算", IDC_CHK_ADDMODE, 280, 260, 70, 14, WS_TABSTOP
    COMBOBOX IDC_COMBO_SELECTVAL, 280, 243, 115, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_COMBO_CHECKVAL, 280, 243, 115, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_COMBO_FONTVAL, 280, 243, 115, 160, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "色", IDC_BTN_COLOR, 400, 241, 25, 16
    PUSHBUTTON "参照", IDC_BTN_FILE_BROWSE, 400, 241, 35, 16
    LTEXT "位置:", IDC_STATIC_POSLABEL, 20, 270, 35, 14
    COMBOBOX IDC_COMBO_POS, 55, 268, 100, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "レイヤー:", IDC_STATIC_LAYERLABEL, 165, 270, 45, 14
    EDITTEXT IDC_EDIT_LAYER, 215, 268, 30, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "※対象は種別切替で自動更新。パラメータ名は対象選択で自動更新", -1, 20, 295, 440, 14
    PUSHBUTTON "▶ 追加", IDC_BTN_ADD_STEP, 20, 318, 90, 30
    PUSHBUTTON "更新", IDC_BTN_UPDATE, 120, 318, 80, 30
    LTEXT "※選択したステップの内容を編集→「更新」で上書き。「追加」で新規", -1, 210, 323, 250, 24

    PUSHBUTTON "OK", IDC_BTN_OK, 310, 395, 75, 24
    PUSHBUTTON "キャンセル", IDC_BTN_CANCEL, 395, 395, 75, 24
END
